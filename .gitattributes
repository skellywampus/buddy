* text=auto
*.bat text eol=crlf
*.command text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.bin binary
*.UPD binary
*.wav binary
*.png binary
*.docx binary
*.gz binary
# Release/source hashes are byte-sensitive on every checkout platform.
/firmware/** -text
/third_party/** -text
/releases/** -text
